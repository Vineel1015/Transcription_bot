# ============================================================================================================
# Required
# ============================================================================================================

# Claude API key. The only secret needed to run locally (docker compose up && make demo).
ANTHROPIC_API_KEY=

# ============================================================================================================
# Optional — every setting below has a working default
# ============================================================================================================

# --- Core ---------------------------------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://recall:recall@localhost:5432/recall   # compose sets this for you
# PUBLIC_BASE_URL=http://localhost:8000     # https URL users and Microsoft reach Recall on (webhooks, bot)
# RUN_MIGRATIONS_ON_STARTUP=true            # production runs migrations as a separate Container Apps job
# RUN_WORKERS=true                          # job workers + scheduler inside the app process
# WORKER_CONCURRENCY=4
# LOG_LEVEL=INFO

# --- Local auth (never in production) -------------------------------------------------------------------------
# DEV_AUTH=true                             # accept "Authorization: Bearer $DEV_TOKEN" (+ optional X-Dev-User: email)
# DEV_TOKEN=dev
# SERVICE_TOKEN=                            # admin token for automation such as deploy smoke tests
# ENTRA_API_AUDIENCE=                       # audience (client id / app id URI) of Entra tokens for the REST API

# --- Models and cost controls (see docs/ARCHITECTURE.md#cost-controls) ----------------------------------------
# SUMMARIZER_STANDUP_MODEL=claude-haiku-4-5-20251001   # standups up to STANDUP_HAIKU_MAX_MINUTES
# STANDUP_HAIKU_MAX_MINUTES=30
# SUMMARIZER_MODEL=claude-sonnet-5
# SUMMARIZER_EFFORT=medium
# AGENT_MODEL=claude-sonnet-5
# AGENT_EFFORT=low
# AGENT_ESCALATION_EFFORT=medium            # one retry at this effort when the first pass finds nothing
# ROUTER_MODEL=claude-haiku-4-5-20251001    # only when keyword rules can't tell the intent
# AGENT_MAX_TOOL_CALLS=4
# AGENT_MAX_TOKENS=1024
# USE_BATCH_API=true                        # non-standup meetings summarized via the Batch API (50% off)
# DEFAULT_TEAM_BUDGET_USD=25                # monthly Claude budget for new teams
# MIN_MEETING_SECONDS=180                   # shorter meetings are skipped before any model call
# MIN_MEETING_WORDS=300
# LLM_PRICES_JSON=                          # override $/Mtok, e.g. {"claude-sonnet-5":{"input":2,"output":10}}
# ANTHROPIC_PROVIDER=anthropic              # or "foundry" to process through Microsoft Foundry
# FOUNDRY_RESOURCE=
# FOUNDRY_API_KEY=

# --- Embeddings ------------------------------------------------------------------------------------------------
# EMBEDDINGS_PROVIDER=local                 # local (fastembed, no key) | voyage | hash (tests only)
# EMBEDDING_DIM=384                         # must be set BEFORE the first migration; Voyage needs 512 or 1024
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5

# --- Speech to text (uploaded recordings only; Teams provides transcripts) ------------------------------------
# STT_PROVIDER=auto                         # auto = Deepgram if DEEPGRAM_API_KEY is set, else local whisper
# DEEPGRAM_API_KEY=
# WHISPER_MODEL=small                       # needs the "whisper" extra: uv sync --extra whisper

# --- Media storage ---------------------------------------------------------------------------------------------
# MEDIA_STORAGE=local                       # local | azure_blob | s3
# MEDIA_LOCAL_DIR=./data/media
# AZURE_STORAGE_ACCOUNT_URL=                # https://<account>.blob.core.windows.net (managed identity)
# AZURE_STORAGE_CONTAINER=media
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=

# --- Microsoft Graph (Teams transcripts) — see docs/TEAMS_SETUP.md ---------------------------------------------
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_CLIENT_STATE=change-me              # random string; Graph echoes it on every notification
# GRAPH_WEBHOOK_URL=                        # defaults to $PUBLIC_BASE_URL/graph/notifications
# GRAPH_POLL_ORGANIZERS=                    # comma-separated organizer user ids polled every 15 min
# GRAPH_SUBSCRIPTION_HOURS=48

# --- Teams bot -------------------------------------------------------------------------------------------------
# BOT_APP_ID=
# BOT_APP_PASSWORD=
# BOT_TENANT_ID=
# COMPANY_NAME=Contoso                      # shown in the Teams app listing (make teams-package)

# --- Observability ---------------------------------------------------------------------------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# OTEL_SAMPLE_RATIO=0.2

# --- MCP server (recall-mcp) -----------------------------------------------------------------------------------
# MCP_USER_EMAIL=                           # the Recall user the MCP server acts as
