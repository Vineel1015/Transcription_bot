// Recall on Azure: one resource group per environment (dev, prod). Deployed with `azd up`.
targetScope = 'resourceGroup'

@description('Environment name from azd (e.g. dev, prod). Used in resource names.')
param environmentName string

@description('Region for every resource. Match the Microsoft 365 tenant region for data residency.')
param location string = resourceGroup().location

@description('Container image to run. azd sets this on deploy; the placeholder lets provision run first.')
param containerImage string = 'mcr.microsoft.com/k8se/quickstart:latest'

@secure()
@description('PostgreSQL admin password (generated by the azd preprovision hook).')
param postgresPassword string

@secure()
param anthropicApiKey string = ''
@secure()
param graphClientSecret string = ''
@secure()
param botAppPassword string = ''
@secure()
param graphClientState string = ''

param graphTenantId string = ''
param graphClientId string = ''
param botAppId string = ''
param customDomain string = ''

@description('Email address for operational alerts.')
param alertEmail string = ''

@description('Postgres SKU. Start with B1ms; move to Standard_B2s beyond ~100 users.')
param postgresSku string = 'Standard_B1ms'

var token = toLower(uniqueString(subscription().id, resourceGroup().id, environmentName))
var prefix = 'recall-${environmentName}'
var tags = { 'azd-env-name': environmentName, app: 'recall' }

resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${prefix}-id'
  location: location
  tags: tags
}

module network 'modules/network.bicep' = {
  name: 'network'
  params: { prefix: prefix, location: location, tags: tags }
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  params: { prefix: prefix, location: location, tags: tags }
}

module registry 'modules/registry.bicep' = {
  name: 'registry'
  params: { name: 'recall${token}', location: location, tags: tags, pullPrincipalId: identity.properties.principalId }
}

module storage 'modules/storage.bicep' = {
  name: 'storage'
  params: { name: 'recall${token}', location: location, tags: tags, principalId: identity.properties.principalId }
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  params: {
    name: '${prefix}-pg-${token}'
    location: location
    tags: tags
    sku: postgresSku
    adminPassword: postgresPassword
    subnetId: network.outputs.postgresSubnetId
    vnetId: network.outputs.vnetId
  }
}

module keyvault 'modules/keyvault.bicep' = {
  name: 'keyvault'
  params: {
    name: 'kv-${take(token, 18)}'
    location: location
    tags: tags
    readerPrincipalId: identity.properties.principalId
    secrets: {
      'anthropic-api-key': empty(anthropicApiKey) ? 'unset' : anthropicApiKey
      'database-url': 'postgresql+asyncpg://recall:${uriComponent(postgresPassword)}@${postgres.outputs.fqdn}:5432/recall?ssl=require'
      'graph-client-secret': empty(graphClientSecret) ? 'unset' : graphClientSecret
      'bot-app-password': empty(botAppPassword) ? 'unset' : botAppPassword
      'graph-client-state': empty(graphClientState) ? uniqueString(token, 'client-state') : graphClientState
      'service-token': uniqueString(token, 'service-token', postgresPassword)
    }
  }
}

module app 'modules/containerapp.bicep' = {
  name: 'containerapp'
  params: {
    prefix: prefix
    location: location
    tags: tags
    image: containerImage
    identityId: identity.id
    identityClientId: identity.properties.clientId
    registryServer: registry.outputs.loginServer
    infrastructureSubnetId: network.outputs.appsSubnetId
    logAnalyticsCustomerId: monitoring.outputs.logAnalyticsCustomerId
    logAnalyticsKey: monitoring.outputs.logAnalyticsKey
    appInsightsConnectionString: monitoring.outputs.appInsightsConnectionString
    keyVaultUri: keyvault.outputs.uri
    storageAccountUrl: storage.outputs.blobEndpoint
    graphTenantId: graphTenantId
    graphClientId: graphClientId
    botAppId: botAppId
    customDomain: customDomain
  }
}

module bot 'modules/bot.bicep' = if (!empty(botAppId)) {
  name: 'bot'
  params: {
    name: '${prefix}-bot-${token}'
    tags: tags
    appId: botAppId
    tenantId: empty(graphTenantId) ? subscription().tenantId : graphTenantId
    endpoint: 'https://${app.outputs.fqdn}/api/messages'
  }
}

module alerts 'modules/alerts.bicep' = {
  name: 'alerts'
  params: {
    prefix: prefix
    location: location
    tags: tags
    appInsightsId: monitoring.outputs.appInsightsId
    postgresId: postgres.outputs.id
    alertEmail: alertEmail
  }
}

output AZURE_CONTAINER_REGISTRY_ENDPOINT string = registry.outputs.loginServer
output AZURE_CONTAINER_APP_NAME string = app.outputs.name
output AZURE_MIGRATION_JOB_NAME string = app.outputs.migrationJobName
output AZURE_KEY_VAULT_NAME string = keyvault.outputs.name
output SERVICE_APP_ENDPOINT_URL string = 'https://${app.outputs.fqdn}'
output GRAPH_WEBHOOK_URL string = 'https://${app.outputs.fqdn}/graph/notifications'
output BOT_MESSAGING_ENDPOINT string = 'https://${app.outputs.fqdn}/api/messages'
